#!/usr/bin/env bash
# Install/update the language servers enabled in nvim/plugin/22_plugins.lua.
#
# Usage:
#   lsp-manage list              show every LSP with its source and installed version
#   lsp-manage outdated          check upstream for newer versions (hits the network)
#   lsp-manage update all        install/update everything
#   lsp-manage update <name>     install/update a single LSP (e.g. gopls, eslint)
#
# `list` is local-only and fast. Only `outdated` and `update` touch the network.
#
# roslyn_ls is intentionally not handled here: it requires the .NET SDK,
# which isn't installed on this machine. Install manually with:
#   dotnet tool install --global roslyn-language-server --prerelease

set -euo pipefail

# name       manager  package
ENTRIES="
bashls      npm      bash-language-server
biome       npm      @biomejs/biome
cssls       npm      vscode-langservers-extracted
html        npm      vscode-langservers-extracted
eslint      npm      vscode-langservers-extracted
svelte      npm      svelte-language-server
tailwindcss npm      @tailwindcss/language-server
vtsls       npm      @vtsls/language-server
yamlls      npm      yaml-language-server
oxlint      npm      oxlint
oxfmt       npm      oxfmt
copilot     npm      @github/copilot-language-server
tsc         npm      typescript
gopls       go       golang.org/x/tools/gopls
emmylua_ls  cargo    emmylua_ls
taplo       cargo    taplo-cli
marksman    bin      artempyanykh/marksman
"

MARKSMAN_REPO="artempyanykh/marksman"

declare -A INSTALLED

# One npm call and one cargo call for every package, rather than one per LSP.
load_installed() {
  local pkg ver
  while IFS=$'\t' read -r pkg ver; do
    [[ -n "$pkg" ]] && INSTALLED[$pkg]=$ver
  done < <(
    npm list -g --depth=0 --json 2>/dev/null |
      jq -r '.dependencies // {} | to_entries[] | "\(.key)\t\(.value.version)"' 2>/dev/null || true
  )

  while IFS=$'\t' read -r pkg ver; do
    [[ -n "$pkg" ]] && INSTALLED[$pkg]=$ver
  done < <(
    cargo install --list 2>/dev/null |
      sed -n 's/^\([^ ]*\) v\([0-9][0-9.]*\):$/\1\t\2/p' || true
  )

  if command -v gopls >/dev/null 2>&1; then
    INSTALLED[golang.org / x / tools / gopls]=$(
      gopls version 2>/dev/null | grep -o 'v[0-9][0-9.]*' | head -1 | tr -d v || true
    )
  fi

  if command -v marksman >/dev/null 2>&1; then
    INSTALLED[$MARKSMAN_REPO]=$(marksman --version 2>/dev/null | head -1 || true)
  fi
}

npm_latest() { npm view "$1" version 2>/dev/null || true; }

go_latest() {
  go list -m -versions "$1" 2>/dev/null | tr ' ' '\n' | tail -1 | tr -d v || true
}

cargo_latest() {
  cargo search "$1" 2>/dev/null | sed -n "s/^$1 = \"\([0-9][0-9.]*\)\".*/\1/p" | head -1 || true
}

marksman_latest() {
  curl -fsSL "https://api.github.com/repos/${MARKSMAN_REPO}/releases/latest" 2>/dev/null |
    jq -r '.tag_name // empty' 2>/dev/null || true
}

latest_for() {
  case "$1" in
  npm) npm_latest "$2" ;;
  go) go_latest "$2" ;;
  cargo) cargo_latest "$2" ;;
  bin) marksman_latest ;;
  esac
}

marksman_arch() {
  case "$(uname -m)" in
  aarch64 | arm64) echo "arm64" ;;
  x86_64) echo "x64" ;;
  *) echo "unsupported" ;;
  esac
}

install_one() {
  local manager=$2 pkg=$3
  case "$manager" in
  npm)
    echo "==> npm install -g $pkg"
    npm install -g "$pkg"
    ;;
  go)
    echo "==> go install ${pkg}@latest"
    go install "${pkg}@latest"
    ;;
  cargo)
    # Some crates force openssl-sys's vendored feature, which tries to
    # compile OpenSSL from source and fails without perl-FindBin. Force
    # linking against the system openssl-devel instead.
    export OPENSSL_NO_VENDOR=1
    if [[ "$pkg" == "taplo-cli" ]]; then
      echo "==> cargo install --features lsp --locked taplo-cli"
      cargo install --features lsp --locked taplo-cli
    else
      echo "==> cargo install $pkg"
      cargo install "$pkg"
    fi
    ;;
  bin)
    local tag arch url dest
    arch=$(marksman_arch)
    if [[ "$arch" == "unsupported" ]]; then
      echo "!! unsupported architecture for marksman: $(uname -m)" >&2
      return 1
    fi
    tag=$(marksman_latest)
    url="https://github.com/${pkg}/releases/download/${tag}/marksman-linux-${arch}"
    dest="$HOME/.local/bin/marksman"
    echo "==> downloading marksman $tag ($arch) -> $dest"
    curl -fsSL "$url" -o "$dest"
    chmod +x "$dest"
    ;;
  esac
}

cmd_list() {
  load_installed
  printf '%-12s %-6s %s\n' "NAME" "SOURCE" "INSTALLED"
  while read -r name manager pkg; do
    [[ -z "$name" ]] && continue
    printf '%-12s %-6s %s\n' "$name" "$manager" "${INSTALLED[$pkg]:-- (not installed)}"
  done <<<"$ENTRIES"
}

# Fetch every upstream version in parallel; one subshell per unique package.
cmd_outdated() {
  load_installed
  # Global, not local: the EXIT trap runs after this function has returned.
  TMP=$(mktemp -d)
  trap 'rm -rf "$TMP"' EXIT

  local -A seen
  while read -r _name manager pkg; do
    [[ -z "$manager" || -n "${seen[$pkg]:-}" ]] && continue
    seen[$pkg]=1
    (latest_for "$manager" "$pkg" >"$TMP/$(echo "$pkg" | tr '/@.' '___')") &
  done <<<"$ENTRIES"
  wait

  local found=0
  while read -r name manager pkg; do
    [[ -z "$name" ]] && continue
    local installed latest
    installed=${INSTALLED[$pkg]:-}
    latest=$(cat "$TMP/$(echo "$pkg" | tr '/@.' '___')" 2>/dev/null || true)
    latest=${latest:-"?"}
    if [[ -z "$installed" ]]; then
      [[ $found -eq 0 ]] && printf '%-12s %-6s %-14s %s\n' "NAME" "SOURCE" "INSTALLED" "LATEST" && found=1
      printf '%-12s %-6s %-14s %s\n' "$name" "$manager" "-" "$latest"
    elif [[ "$installed" != "$latest" && "$latest" != "?" ]]; then
      [[ $found -eq 0 ]] && printf '%-12s %-6s %-14s %s\n' "NAME" "SOURCE" "INSTALLED" "LATEST" && found=1
      printf '%-12s %-6s %-14s %s\n' "$name" "$manager" "$installed" "$latest"
    fi
  done <<<"$ENTRIES"

  [[ $found -eq 0 ]] && echo "everything is up to date"
  return 0
}

cmd_update() {
  local target=$1 known
  known=$(awk 'NF{print $1}' <<<"$ENTRIES")
  if [[ "$target" != "all" ]] && ! grep -qx "$target" <<<"$known"; then
    echo "!! unknown LSP name: $target" >&2
    echo "   known: $(tr '\n' ' ' <<<"$known")" >&2
    exit 1
  fi
  # cssls/html/eslint share one npm package; don't reinstall it three times.
  local -A done_pkgs
  while read -r name manager pkg; do
    [[ -z "$name" ]] && continue
    if [[ "$target" == "all" || "$target" == "$name" ]]; then
      [[ -n "${done_pkgs[$pkg]:-}" ]] && continue
      done_pkgs[$pkg]=1
      install_one "$name" "$manager" "$pkg"
    fi
  done <<<"$ENTRIES"
}

case "${1:-}" in
list) cmd_list ;;
outdated) cmd_outdated ;;
update)
  [[ -z "${2:-}" ]] && {
    echo "usage: lsp-manage update <all|name>" >&2
    exit 1
  }
  cmd_update "$2"
  ;;
*)
  echo "usage: lsp-manage <list|outdated|update> [name]" >&2
  exit 1
  ;;
esac
