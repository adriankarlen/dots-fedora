# .config — runtime/state
/home/.config/gh/
/home/.config/github-copilot/
/home/.config/mozilla/firefox
/home/.config/net.imput.helium
/home/.config/go/telemetry/local
/home/.config/mcp
/home/.config/mimeapps.list
/home/.config/dconf
/home/.config/pulse
/home/.config/opencode
/home/.config/wo
/home/.config/pi
/home/.config/lazyspotify
!/home/.config/lazyspotify/config.toml
/home/.config/cava
!/home/.config/cava/config

# claude — local settings (any depth)
**/.claude/settings.local.json

# pi agent runtime/state (keep settings + customization resources tracked)
/home/.pi/agent/*
/home/.pi/todos/*
/home/.pi/.pi/todos/*
/home/.pi/todos/*

# pi MCP adapter runtime/secrets
/home/.pi/agent/mcp-oauth/
/home/.pi/agent/mcp-cache.json
/home/.pi/agent/mcp-npx-cache.json
/home/.pi/agent/mcp-auth.json
/home/.local/share/pi/mcp-auth.json

# pi extensions node_modules
/home/.pi/agent/extensions/**/node_modules/

!/home/.pi/agent/tsconfig.json
!/home/.pi/agent/package.json
!/home/.pi/agent/themes/
!/home/.pi/agent/themes/*.json
!/home/.pi/agent/extensions/
!/home/.pi/agent/extensions/**
!/home/.pi/agent/keybindings.json
!/home/.pi/agent/mcp.json
!/home/.pi/agent/pi-permissions.jsonc
# settings.json is intentionally NOT tracked: pi rewrites it on model
# switches, changelog dismissal, etc. See scripts/install-pi-packages.sh
# for the tracked source of truth on installed packages.
!/home/.pi/agent/APPEND_SYSTEM.md
