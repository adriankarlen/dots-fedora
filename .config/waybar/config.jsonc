// -*- mode: jsonc -*-
{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 40,
    "margin-right": 8,
    "margin-left": 8,
    "margin-top": 8,

    "modules-left": ["sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["group/right"],

    "group/right": {
        "orientation": "inherit",
        "modules": [ "mpris", "pulseaudio", "network","clock" ]
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "disable-click": true,
        "all-outputs": true,
        "persistent-workspaces": {
            "1": [], "2": [], "3": [], "4": [], "5": []
        }
    },

    "sway/window": {
        "format": "{title}",
        "max-length": 40,
        "tooltip": true
    },
    "clock": {
        "format": "<span color='#eb6f92'></span> {:%H:%M}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "mpris": {
        "format": "<span color='#31748f'></span> {artist} - {title}",
        "format-paused": "<span color='#31748f'></span> {artist} - {title}",
        "artist-len": 18,
        "title-len": 24,
        "max-length": 48,
        "tooltip-format": "{player} ({status})\n{artist} - {title}\n{album}"
    },
    "pulseaudio": {
        "format": "<span color='#9ccfd8'>{icon}</span> {volume}%",
        "format-muted": "<span color='#eb6f92'></span> muted",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "format-icons": {
            "default": ["", "", ""]
        }
    },
    "network": {
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-wifi": "<span color='#f6c177'>{icon}</span> {essid}",
        "format-ethernet": "󰌘 Wired",
        "format-disconnected": "󰤮 Disconnected",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "on-click": "ghostty --class=com.mitchellh.ghostty.wlctl --adjust-cell-height=0 -e /home/adk/.cargo/bin/wlctl"
    }
}
