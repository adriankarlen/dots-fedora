# mako - notification daemon
# Rose Pine, flat/squared, matching the sway + waybar setup.
# mako is D-Bus activated (fr.emersion.mako.service), so it starts on the
# first notification; no exec line in the sway config is needed.
# Reload after editing with: makoctl reload

font=Berkeley Mono 11

# mako honours waybar's layer-shell exclusive zone, so it already sits below
# the bar; this is just the gap, matching sway's `gaps inner 8`.
anchor=top-right
margin=8

width=380
height=140
padding=12
border-size=2
border-radius=0

# Rose Pine: base bg, text fg, unfocused-border to match sway's client.unfocused
background-color=#191724
text-color=#e0def4
border-color=#403d52
progress-color=over #403d52

default-timeout=5000

icons=0
markup=1

format=<b>%s</b>\n%b

[urgency=low]
text-color=#908caa
border-color=#26233a
default-timeout=5000

[urgency=normal]
text-color=#e0def4
border-color=#403d52
default-timeout=5000

[urgency=critical]
text-color=#e0def4
border-color=#eb6f92
progress-color=over #eb6f92
default-timeout=0
