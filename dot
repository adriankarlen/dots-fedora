#!/usr/bin/env bash
# dot — thin wrapper around GNU Stow for the dots-fedora repo.
#
# Replaces the manual `stow -d <repo> -t ~ home` invocation with a small
# command set: `stow`/`unstow`/`restow` are the core, plus `doctor` to
# verify symlink health, `link`/`unlink` to (un)install `dot` itself into
# ~/.local/bin, `edit` to open the repo in $EDITOR, `update` to refresh
# everything this machine has installed, and `outdated` to report on it
# without changing anything.
#
# Out of scope (deliberately deferred, may be added later):
#   - SSH key generation
#   - shell / font bootstrapping
#
# Anything beyond creating/removing symlinks under $HOME should be left
# to a dedicated script in ./scripts/ (see scripts/install-pi-packages.sh
# for the pattern this file follows).

set -euo pipefail

# ─── Colors ──────────────────────────────────────────────────────────────────
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly RESET='\033[0m'
readonly BOLD='\033[1m'

# ─── Constants ──────────────────────────────────────────────────────────────
readonly SCRIPT_NAME="dot"
readonly VERSION="0.1.0"
# Resolve DOTFILES_DIR through any symlinks (e.g. when invoked via
# ~/.local/bin/dot → <repo>/dot). `realpath` is from coreutils; available
# on Fedora. Falls back gracefully if absent.
if command -v realpath >/dev/null 2>&1; then
    DOTFILES_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
else
    DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
readonly DOTFILES_DIR
readonly HOME_DIR="${DOTFILES_DIR}/home"
readonly STOW_TARGET="${HOME}"
readonly LINK_DIR="${HOME}/.local/bin"
readonly LINK_PATH="${LINK_DIR}/${SCRIPT_NAME}"
readonly PI_PACKAGES_SCRIPT="${DOTFILES_DIR}/scripts/install-pi-packages.sh"

# Neovim nightly is installed system-wide to /opt (matching how it was
# originally set up by hand: download the nightly tarball for this arch,
# extract to /opt, symlink into /usr/local/bin). Maps `uname -m` to the
# arch suffix neovim/neovim uses for its Linux release assets; empty for
# anything unsupported.
case "$(uname -m)" in
    aarch64|arm64) NVIM_NIGHTLY_ARCH="arm64" ;;
    x86_64|amd64)  NVIM_NIGHTLY_ARCH="x86_64" ;;
    *)             NVIM_NIGHTLY_ARCH="" ;;
esac
readonly NVIM_NIGHTLY_ARCH
readonly NVIM_NIGHTLY_DIR="/opt/nvim-linux-${NVIM_NIGHTLY_ARCH}"
readonly NVIM_NIGHTLY_BIN="${NVIM_NIGHTLY_DIR}/bin/nvim"
readonly NVIM_NIGHTLY_LINK="/usr/local/bin/nvim"

# Representative paths to spot-check in `doctor`. Mix of top-level files
# (stow'd as individual symlinks) and nested entries under .config
# (reachable via the tree-fold symlink at ~/.config → home/.config).
readonly -a DOCTOR_PATHS=(
    ".zshenv"
    ".zshrc"
    ".config"
    ".config/ohmyposh"
    ".config/nvim"
    ".agents"
)

# ─── Helpers ────────────────────────────────────────────────────────────────
__print_header() {
    echo -e "\n${BOLD}${BLUE}==>${RESET} ${BOLD}$1${RESET}"
}

__print_success() {
    echo -e "${GREEN}✓${RESET} $1"
}

__print_error() {
    echo -e "${RED}✗${RESET} $1" >&2
}

__print_warning() {
    echo -e "${YELLOW}⚠${RESET} $1"
}

__print_info() {
    echo -e "${CYAN}ℹ${RESET} $1"
}

# Set by cmd_update's flag parsing when a single target is given.
# Progress indicators for update's step runner.
CURRENT_STEP=0
TOTAL_STEPS=0

__print_step() {
    ((++CURRENT_STEP))
    echo -e "\n${BOLD}[${CURRENT_STEP}/${TOTAL_STEPS}]${RESET} $1"
}

__command_exists() {
    command -v "$1" >/dev/null 2>&1
}

__require_stow() {
    if ! __command_exists stow; then
        __print_error "GNU Stow is not installed"
        __print_info "Install with: sudo dnf install stow"
        return 1
    fi
}

# ─── Commands ────────────────────────────────────────────────────────────────
cmd_stow() {
    local no_restow=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                echo -e "${BOLD}USAGE:${RESET}"
                echo -e "    ${SCRIPT_NAME} stow [--no-restow]"
                echo
                echo "Create or refresh symlinks from ${HOME_DIR}/ into ${STOW_TARGET}/."
                echo "Default behavior is 'stow --restow' (idempotent — refreshes existing"
                echo "links and adds new ones). Pass --no-restow for an additive-only stow"
                echo "that won't touch links already in place."
                return 0
                ;;
            --no-restow)
                no_restow=true
                shift
                ;;
            *)
                __print_error "Unknown option: $1"
                __print_info "Run '${SCRIPT_NAME} stow --help' for usage"
                return 1
                ;;
        esac
    done

    __require_stow

    __print_header "Stowing dotfiles"
    __print_info "Source: ${HOME_DIR}"
    __print_info "Target: ${STOW_TARGET}"

    local -a flags=(-v -d "${DOTFILES_DIR}" -t "${STOW_TARGET}")
    if [[ "$no_restow" == false ]]; then
        flags=(-R "${flags[@]}")
    fi

    # If stow aborts because of "existing target is not owned by stow"
    # conflicts, the most common cause is symlinks in $HOME that point
    # into ${HOME_DIR} with absolute paths (hand-created before stow was
    # adopted). Stow only manages relative symlinks, so it sees them as
    # foreign. We auto-replace such symlinks with whatever stow wants.
    # This is safe: we only touch symlinks that already point into
    # ${HOME_DIR}, never real files, and only when stow would create the
    # same logical link anyway.
    local attempt=1 max_attempts=5 replaced=true
    while $replaced && [[ $attempt -le $max_attempts ]]; do
        replaced=false
        # Run stow and capture both stdout and stderr (stow writes the
        # conflict list to stderr). `|| true` keeps `set -e` happy on the
        # non-zero exit stow returns after a conflict abort.
        local stow_output
        stow_output=$(stow "${flags[@]}" home 2>&1) || true
        printf '%s\n' "$stow_output"

        # Parse "existing target is not owned by stow: <relpath>" lines.
        # For each conflict, check if the target is an absolute symlink
        # into ${HOME_DIR} — if so, remove it and let stow retry.
        local rel
        while IFS= read -r rel; do
            [[ -z "$rel" ]] && continue
            local link="${STOW_TARGET}/${rel}"
            if [[ -L "$link" ]]; then
                local resolved
                resolved=$(readlink -f "$link")
                if [[ "$resolved" == "${HOME_DIR}"/* ]]; then
                    __print_warning "Replacing manually-created absolute symlink: ${rel} → $(readlink "$link")"
                    rm "$link"
                    replaced=true
                else
                    __print_error "Conflict on ${rel} but it doesn't resolve into ${HOME_DIR} (got ${resolved})"
                    __print_info "Resolve manually, then re-run"
                    return 1
                fi
            else
                __print_error "Conflict on ${rel} but it's not a symlink (stow won't replace it for safety)"
                __print_info "Resolve manually, then re-run"
                return 1
            fi
        done < <(printf '%s\n' "$stow_output" \
            | sed -n 's/^.*existing target is not owned by stow: //p')
        ((++attempt))
    done

    if $replaced; then
        __print_error "Auto-replace hit the ${max_attempts}-attempt limit"
        return 1
    fi
    __print_success "Dotfiles stowed"
}

cmd_unstow() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo -e "${BOLD}USAGE:${RESET}"
        echo -e "    ${SCRIPT_NAME} unstow"
        echo
        echo "Remove the symlinks stow manages under ${STOW_TARGET}/. Files that were"
        echo "not placed there by stow are left alone."
        return 0
    fi

    __require_stow

    __print_header "Unstowing dotfiles"
    stow -D -v -d "${DOTFILES_DIR}" -t "${STOW_TARGET}" home
    __print_success "Dotfiles unstowed"
}

cmd_restow() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo -e "${BOLD}USAGE:${RESET}"
        echo -e "    ${SCRIPT_NAME} restow"
        echo
        echo "Alias for '${SCRIPT_NAME} stow'. Use this when you want to be explicit"
        echo "that you're refreshing, not adding."
        return 0
    fi

    __print_header "Restowing dotfiles"
    __print_info "Source: ${HOME_DIR}"
    __print_info "Target: ${STOW_TARGET}"
    stow -R -v -d "${DOTFILES_DIR}" -t "${STOW_TARGET}" home
    __print_success "Dotfiles restowed"
}

cmd_doctor() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo -e "${BOLD}USAGE:${RESET}"
        echo -e "    ${SCRIPT_NAME} doctor"
        echo
        echo "Verify that stow is installed, that representative dotfile paths under"
        echo "\$HOME are present (as symlinks into ${HOME_DIR}, or reachable via a"
        echo "tree-folded ancestor like ~/.config → home/.config), and that no"
        echo "symlinks under \$HOME are broken."
        return 0
    fi

    __print_header "Running diagnostics"
    local issues=0

    if __command_exists stow; then
        __print_success "GNU Stow installed: $(command -v stow)"
    else
        __print_error "GNU Stow not installed"
        __print_info "Install with: sudo dnf install stow"
        ((++issues))
    fi

    __print_info "Checking representative stowed paths..."
    local rel
    for rel in "${DOCTOR_PATHS[@]}"; do
        local path="${STOW_TARGET}/${rel}"
        if [[ -L "$path" ]]; then
            # Resolve to absolute path: `readlink` returns the raw target
            # (relative or absolute), but stow may have created either kind,
            # so use `readlink -f` to canonicalize before comparing.
            local target resolved
            target=$(readlink "$path")
            resolved=$(readlink -f "$path")
            # Tree-folded symlinks resolve to the package directory itself
            # (e.g. ~/.config → /…/home/.config); individual file symlinks
            # resolve to the file inside the package tree.
            if [[ "$resolved" == "${HOME_DIR}" || "$resolved" == "${HOME_DIR}"/* ]]; then
                __print_success "  ${rel} → ${target}"
            else
                __print_warning "  ${rel} → ${target} (resolves to ${resolved}, not inside ${HOME_DIR})"
            fi
        elif [[ -e "$path" ]]; then
            # Reachable via a tree-folded ancestor symlink (e.g.
            # ~/.config/nvim exists because ~/.config → home/.config).
            __print_success "  ${rel} (reachable via tree-folded ancestor)"
        else
            __print_error "  ${rel} is missing"
            ((++issues))
        fi
    done

    if [[ $issues -gt 0 ]]; then
        __print_info "Run '${SCRIPT_NAME} stow' to repair"
    fi

    __print_info "Scanning for broken symlinks under \$HOME (maxdepth 4)..."
    local broken=0
    while IFS= read -r -d '' link; do
        if [[ ! -e "$link" ]]; then
            ((++broken))
            __print_warning "  broken: ${link}"
        fi
    done < <(find "${STOW_TARGET}" -maxdepth 4 -type l -print0 2>/dev/null)

    if [[ $broken -eq 0 ]]; then
        __print_success "No broken symlinks under \$HOME"
    fi

    if [[ -L "$LINK_PATH" ]]; then
        __print_success "\`dot\` is linked at ${LINK_PATH}"
    elif __command_exists dot; then
        __print_info "\`dot\` is on PATH (but not at ${LINK_PATH})"
    else
        __print_warning "\`dot\` is not on PATH"
        __print_info "Run '${SCRIPT_NAME} link' to install it to ${LINK_PATH}"
    fi

    if [[ $issues -eq 0 ]]; then
        __print_header "All critical checks passed ✓"
    else
        __print_header "Found ${issues} issue(s)"
        return 1
    fi
}

cmd_link() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo -e "${BOLD}USAGE:${RESET}"
        echo -e "    ${SCRIPT_NAME} link"
        echo
        echo "Symlink this script to ${LINK_PATH} so that \`dot\` is on PATH"
        echo "(assumes ${LINK_DIR} is on PATH — it is in the default dotfiles' .zshenv)."
        return 0
    fi

    __print_header "Linking \`dot\` into PATH"

    if [[ ! -d "$LINK_DIR" ]]; then
        __print_info "Creating ${LINK_DIR}"
        mkdir -p "$LINK_DIR"
    fi

    if [[ -e "$LINK_PATH" ]] && [[ ! -L "$LINK_PATH" ]]; then
        __print_error "${LINK_PATH} exists and is not a symlink"
        __print_info "Remove it manually if you want \`dot\` linked there"
        return 1
    fi

    ln -sfn "${DOTFILES_DIR}/${SCRIPT_NAME}" "$LINK_PATH"
    __print_success "Linked ${LINK_PATH} → ${DOTFILES_DIR}/${SCRIPT_NAME}"
    __print_info "Make sure ${LINK_DIR} is on your PATH"
}

cmd_unlink() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo -e "${BOLD}USAGE:${RESET}"
        echo -e "    ${SCRIPT_NAME} unlink"
        echo
        echo "Remove the symlink at ${LINK_PATH} if present."
        return 0
    fi

    __print_header "Unlinking \`dot\` from PATH"

    if [[ -L "$LINK_PATH" ]]; then
        rm "$LINK_PATH"
        __print_success "Removed ${LINK_PATH}"
    else
        __print_warning "No symlink at ${LINK_PATH}"
    fi
}

cmd_edit() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo -e "${BOLD}USAGE:${RESET}"
        echo -e "    ${SCRIPT_NAME} edit"
        echo
        echo "Open the dotfiles repository in \${EDITOR:-nvim}."
        return 0
    fi

    local editor="${EDITOR:-nvim}"
    if ! __command_exists "$editor"; then
        __print_error "Editor '$editor' not found"
        __print_info "Set EDITOR environment variable to specify a different one"
        return 1
    fi

    exec "$editor" "${DOTFILES_DIR}"
}

# ─── Update: refresh everything already installed ───────────────────────
# Companion to `stow`, but for the tools this machine has installed on top
# of the dotfiles themselves: dnf/flatpak system packages, pi packages, vp
# global npm packages + Node, and Yazi packages. Every step below is written
# to be safe to re-run.

__update_dnf() {
    if ! __command_exists dnf; then
        __print_warning "dnf not found, skipping"
        return 0
    fi

    __print_info "Refreshing dnf metadata..."
    sudo dnf makecache --refresh -q || __print_warning "dnf makecache failed (continuing)"

    __print_info "Upgrading system packages..."
    sudo dnf upgrade -y
    __print_success "System packages updated"
}

__update_flatpak() {
    if ! __command_exists flatpak; then
        __print_warning "flatpak not found, skipping"
        return 0
    fi

    __print_info "Updating flatpak apps and runtimes..."
    flatpak update -y
    __print_success "Flatpak apps updated"
}

__update_pi_packages() {
    if ! __command_exists pi; then
        __print_warning "pi not installed, skipping pi package update"
        return 0
    fi

    if [[ -x "$PI_PACKAGES_SCRIPT" ]]; then
        __print_info "Reconciling tracked pi package list..."
        "$PI_PACKAGES_SCRIPT" || __print_warning "install-pi-packages.sh reported issues"
    fi

    __print_info "Updating pi itself and installed packages..."
    pi update --all
    __print_success "pi packages updated"
}

__update_vp_packages() {
    if ! __command_exists vp; then
        __print_warning "vp not installed, skipping vp global package update"
        return 0
    fi

    __print_info "Updating vp global packages..."
    vp update -g --latest
    __print_success "vp global packages updated"
}

__update_yazi_packages() {
    if ! __command_exists ya; then
        __print_warning "yazi not installed, skipping package update"
        return 0
    fi

    __print_info "Upgrading Yazi packages..."
    ya pkg upgrade
    __print_success "Yazi packages upgraded"
}

# Prints "<local_short_hash>\t<remote_full_hash>" for the installed Neovim
# nightly build vs the current neovim/neovim `nightly` tag. Single source of
# truth for this comparison — used by both `dot outdated` and `dot update`.
# Returns 1 (no output) if Neovim nightly isn't installed at
# ${NVIM_NIGHTLY_BIN}, git is unavailable, or either hash can't be determined.
__nvim_nightly_status() {
    __command_exists git || return 1
    [[ -x "$NVIM_NIGHTLY_BIN" ]] || return 1

    local nvim_ver local_hash remote_hash
    nvim_ver="$("$NVIM_NIGHTLY_BIN" --version 2>/dev/null | head -1)"
    local_hash="$(grep -oE '\+g[0-9a-f]+' <<< "$nvim_ver" | sed 's/^+g//')"
    remote_hash="$(git ls-remote https://github.com/neovim/neovim nightly 2>/dev/null | cut -f1)"

    [[ -n "$local_hash" && -n "$remote_hash" ]] || return 1

    echo -e "${local_hash}\t${remote_hash}"
}

# Downloads and installs the current neovim/neovim nightly build to
# ${NVIM_NIGHTLY_DIR} (root-owned, hence sudo), then (re)links
# ${NVIM_NIGHTLY_LINK} to it. Safe to re-run: skips the download entirely
# when the installed build's commit hash already matches the nightly tag.
__install_nvim_nightly() {
    if [[ -z "$NVIM_NIGHTLY_ARCH" ]]; then
        __print_warning "Unsupported architecture for Neovim nightly (uname -m: $(uname -m)), skipping"
        return 0
    fi

    local nvim_status local_hash remote_hash
    if nvim_status="$(__nvim_nightly_status)"; then
        local_hash="${nvim_status%%$'\t'*}"
        remote_hash="${nvim_status##*$'\t'}"
        if [[ "$remote_hash" == "$local_hash"* ]]; then
            __print_success "Neovim nightly already up to date: $("$NVIM_NIGHTLY_BIN" --version | head -1)"
            return 0
        fi
    fi

    __print_info "Installing Neovim nightly..."
    local tarball="nvim-linux-${NVIM_NIGHTLY_ARCH}.tar.gz"
    local tmp
    tmp=$(mktemp -d)

    if ! curl -fL --output-dir "$tmp" -o "$tarball" \
        "https://github.com/neovim/neovim/releases/download/nightly/${tarball}"; then
        __print_error "Failed to download Neovim nightly"
        rm -rf "$tmp"
        return 1
    fi

    if ! sudo rm -rf "$NVIM_NIGHTLY_DIR" \
        || ! sudo tar -C /opt -xzf "${tmp}/${tarball}" \
        || ! sudo ln -sfn "$NVIM_NIGHTLY_BIN" "$NVIM_NIGHTLY_LINK"; then
        __print_error "Failed to install Neovim nightly (sudo step failed)"
        rm -rf "$tmp"
        return 1
    fi
    rm -rf "$tmp"

    if [[ ! -x "$NVIM_NIGHTLY_BIN" ]]; then
        __print_error "Neovim nightly install looked successful but ${NVIM_NIGHTLY_BIN} is missing"
        return 1
    fi

    __print_success "Neovim nightly installed: $("$NVIM_NIGHTLY_BIN" --version | head -1)"
}

readonly -a UPDATE_STEPS=(
    "System packages (dnf)   ;; __update_dnf             ;; dnf"
    "Flatpak apps            ;; __update_flatpak         ;; flatpak"
    "pi packages             ;; __update_pi_packages     ;; pi"
    "vp global packages      ;; __update_vp_packages     ;; vp"
    "Yazi packages           ;; __update_yazi_packages   ;; yazi"
    "Neovim nightly          ;; __install_nvim_nightly   ;; nvim"
)

__update_step_targets() {
    local entry keyword joined=""
    for entry in "${UPDATE_STEPS[@]}"; do
        keyword="$(cut -d';' -f5 <<< "$entry" | xargs)"
        joined+="${keyword}, "
    done
    echo "${joined%, }"
}

__run_update_steps() {
    local target="${1:-}"
    local -a steps=()
    local entry keyword

    if [[ -n "$target" ]]; then
        for entry in "${UPDATE_STEPS[@]}"; do
            keyword="$(cut -d';' -f5 <<< "$entry" | xargs)"
            [[ "$keyword" == "$target" ]] && steps+=("$entry")
        done
        if [[ ${#steps[@]} -eq 0 ]]; then
            __print_error "Unknown update target: ${target}"
            __print_info "Valid targets: $(__update_step_targets)"
            return 1
        fi
    else
        steps=("${UPDATE_STEPS[@]}")
    fi

    TOTAL_STEPS=${#steps[@]}
    CURRENT_STEP=0

    local name fn
    for entry in "${steps[@]}"; do
        name="$(cut -d';' -f1 <<< "$entry" | xargs)"
        fn="$(cut -d';' -f3 <<< "$entry" | xargs)"

        __print_step "$name"

        if "$fn"; then
            true
        else
            __print_warning "$name failed (continuing)"
        fi
    done
}

cmd_update() {
    local target=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                echo -e "${BOLD}USAGE:${RESET}"
                echo -e "    ${SCRIPT_NAME} update [TARGET]"
                echo
                echo "Update everything this machine has installed on top of the dotfiles:"
                echo "dnf system packages, flatpak apps, pi itself and its installed"
                echo "packages, vp global npm packages, Yazi packages, and Neovim nightly"
                echo "(built from source releases, installed to"
                echo "${NVIM_NIGHTLY_DIR}). dnf, flatpak, and Neovim steps use sudo."
                echo
                echo "Give TARGET to update just one of these instead of everything."
                echo "Valid targets: $(__update_step_targets)"
                echo
                echo "Safe to re-run: every step just refreshes whatever is already there."
                echo
                echo -e "${BOLD}EXAMPLES:${RESET}"
                echo "    ${SCRIPT_NAME} update              # update everything"
                echo "    ${SCRIPT_NAME} update pi           # update pi packages only"
                return 0
                ;;
            -*)
                __print_error "Unknown update option: $1"
                __print_info "Run '${SCRIPT_NAME} update --help' for usage"
                return 1
                ;;
            *)
                if [[ -n "$target" ]]; then
                    __print_error "Only one update target can be given at a time"
                    __print_info "Run '${SCRIPT_NAME} update --help' for usage"
                    return 1
                fi
                target="$1"
                shift
                ;;
        esac
    done

    if [[ -n "$target" ]]; then
        __print_header "Updating: ${target}"
    else
        __print_header "Updating installed tools"
    fi
    __run_update_steps "$target" || return 1
    __print_header "Update complete! \xf0\x9f\x8e\x89"
}

# ─── Outdated: read-only report across every package manager in play ────
cmd_outdated() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo -e "${BOLD}USAGE:${RESET}"
        echo -e "    ${SCRIPT_NAME} outdated"
        echo
        echo "Check every package manager and tool this machine tracks for available"
        echo "updates: dnf system packages, flatpak apps, pi packages, vp-managed"
        echo "global npm packages and Node.js itself, Yazi packages/flavors, and"
        echo "Neovim nightly."
        echo "Prints one combined, easy-to-scan report per source."
        echo
        echo "Read-only: this only checks, it never installs anything. Run"
        echo "'${SCRIPT_NAME} update' to actually update what's reported here."
        return 0
    fi

    if ! __command_exists jq; then
        __print_error "jq is required for '${SCRIPT_NAME} outdated' (sudo dnf install jq)"
        return 1
    fi

    __print_header "Checking for outdated packages"
    local grand_total=0 count

    if __command_exists dnf; then
        __print_info "Refreshing dnf metadata..."
        local dnf_output="" dnf_status=0
        dnf_output="$(dnf check-update --refresh -q 2>/dev/null)" || dnf_status=$?

        if [[ $dnf_status -eq 100 ]]; then
            local dnf_rows
            dnf_rows="$(awk 'NF==3 {print $1"\t"$2"\t"$3}' <<< "$dnf_output")"
            count=$(grep -c $'\t' <<< "$dnf_rows")
            __outdated_section "System packages (dnf)" "PACKAGE\tVERSION\tREPO" "$dnf_rows"
            grand_total=$((grand_total + count))
        elif [[ $dnf_status -eq 0 ]]; then
            __print_success "System packages (dnf): up to date"
        else
            __print_warning "dnf check-update failed (exit ${dnf_status}), skipping"
        fi
    else
        __print_warning "dnf not installed, skipping"
    fi

    if __command_exists flatpak; then
        local flatpak_rows="" flatpak_count=0 remote name version branch
        while IFS= read -r remote; do
            [[ -z "$remote" ]] && continue
            while IFS=$'\t' read -r name version branch; do
                [[ -z "$name" ]] && continue
                flatpak_rows+="${name}"$'\t'"${version}"$'\t'"${branch}"$'\n'
                ((++flatpak_count))
            done < <(flatpak remote-ls --updates "$remote" --columns=name,version,branch 2>/dev/null)
        done < <(flatpak remotes --columns=name 2>/dev/null)
        flatpak_rows="${flatpak_rows%$'\n'}"
        __outdated_section "Flatpak apps" "NAME\tVERSION\tBRANCH" "$flatpak_rows"
        grand_total=$((grand_total + flatpak_count))
    else
        __print_warning "flatpak not installed, skipping"
    fi

    if __command_exists vp; then
        local vp_json vp_rows vp_status=0
        vp_json="$(vp outdated -g --format json 2>/dev/null)" || vp_status=$?
        # vp exits non-zero merely to signal "outdated packages found" (like
        # npm outdated), not to indicate a failed check — don't let that
        # trigger a fallback here, or the fallback's output would get
        # concatenated onto the real JSON in the capture above. Only fall
        # back to an empty object when there's truly no output.
        [[ -z "$vp_json" ]] && vp_json='{}'

        vp_rows="$(jq -r 'to_entries[] | "\(.key)\t\(.value.current)\t\(.value.latest)"' <<< "$vp_json")"
        __outdated_section "vp global packages" "NAME\tCURRENT\tLATEST" "$vp_rows"
        count=$(jq 'keys | length' <<< "$vp_json"); grand_total=$((grand_total + count))

        local vp_node_current vp_node_latest_lts
        vp_node_current="$(vp env current --json 2>/dev/null | jq -r '.node.version // empty')"
        vp_node_latest_lts="$(vp env list-remote --lts --json 2>/dev/null | jq -r '.node[] | select(.latest_lts==true) | .version' | tail -1)"
        if [[ -n "$vp_node_current" && -n "$vp_node_latest_lts" && "$vp_node_current" != "$vp_node_latest_lts" ]]; then
            __outdated_section "Node.js (vp)" "CURRENT\tLATEST_LTS" "${vp_node_current}\t${vp_node_latest_lts}"
            ((++grand_total))
        else
            __print_success "Node.js (vp): up to date${vp_node_current:+ (${vp_node_current})}"
        fi
    else
        __print_warning "vp not installed, skipping"
    fi

    if __command_exists pi; then
        local pi_rows="" pi_count=0 pi_name pi_path pi_installed pi_latest
        while IFS=$'\t' read -r pi_name pi_path; do
            [[ -z "$pi_name" ]] && continue
            pi_installed="$(jq -r '.version // empty' "${pi_path}/package.json" 2>/dev/null)"
            pi_latest="$(npm view "$pi_name" version 2>/dev/null)"
            if [[ -n "$pi_installed" && -n "$pi_latest" && "$pi_installed" != "$pi_latest" ]]; then
                pi_rows+="${pi_name}"$'\t'"${pi_installed}"$'\t'"${pi_latest}"$'\n'
                ((++pi_count))
            fi
        done < <(pi list 2>/dev/null | awk '
            /^  npm:/ { name=$0; sub(/^  npm:/,"",name); next }
            /^    / { path=$0; gsub(/^ +/,"",path); print name "\t" path }
        ')
        pi_rows="${pi_rows%$'\n'}"
        __outdated_section "pi packages" "NAME\tINSTALLED\tLATEST" "$pi_rows"
        grand_total=$((grand_total + pi_count))
    else
        __print_warning "pi not installed, skipping"
    fi

    if __command_exists ya && [[ -f "$HOME/.config/yazi/package.toml" ]]; then
        local yazi_rows="" yazi_count=0 use rev remote_hash
        while IFS=$'\t' read -r use rev; do
            [[ -z "$use" || -z "$rev" ]] && continue
            remote_hash="$(git ls-remote "https://github.com/${use}.yazi" HEAD 2>/dev/null | cut -f1)"
            if [[ -n "$remote_hash" && "$remote_hash" != "$rev"* ]]; then
                yazi_rows+="${use}"$'\t'"${rev}"$'\t'"${remote_hash:0:7}"$'\n'
                ((++yazi_count))
            fi
        done < <(awk -F'"' '/^use = / {u=$2} /^rev = / {print u "\t" $2}' "$HOME/.config/yazi/package.toml")
        yazi_rows="${yazi_rows%$'\n'}"
        __outdated_section "Yazi packages" "NAME\tPINNED\tLATEST" "$yazi_rows"
        grand_total=$((grand_total + yazi_count))
    else
        __print_warning "Yazi packages not found, skipping"
    fi

    local nvim_status local_hash remote_hash
    if nvim_status="$(__nvim_nightly_status)"; then
        local_hash="${nvim_status%%$'\t'*}"
        remote_hash="${nvim_status##*$'\t'}"
        if [[ "$remote_hash" != "$local_hash"* ]]; then
            __outdated_section "Neovim nightly" "LOCAL\tREMOTE" "${local_hash}\t${remote_hash:0:7}"
            ((++grand_total))
        else
            __print_success "Neovim nightly: up to date"
        fi
    else
        __print_warning "Neovim nightly not installed, skipping"
    fi

    if [[ $grand_total -eq 0 ]]; then
        __print_success "Everything is up to date"
    else
        __print_warning "${grand_total} package(s) outdated total \xe2\x80\x94 run '${SCRIPT_NAME} update' to update them"
    fi
}

__outdated_section() {
    # $1=section title  $2=header row (tab-separated)  $3=body (tab-separated rows, one per line)
    local title="$1" header="$2" body="$3"
    local count=0
    if [[ -n "$body" ]]; then
        count=$(wc -l <<< "$body")
    fi

    if [[ "$count" -eq 0 ]]; then
        __print_success "${title}: up to date"
        return 0
    fi

    __print_warning "${title}: ${count} outdated"
    { echo -e "$header"; echo -e "$body"; } | column -t -s $'\t' | sed 's/^/    /'
    echo
    return 0
}

cmd_help() {
    local command_name="${1:-}"
    if [[ -n "$command_name" ]]; then
        if declare -F "cmd_${command_name}" >/dev/null; then
            "cmd_${command_name}" --help
            return
        fi
        __print_error "Unknown command: $command_name"
        echo "Run '${SCRIPT_NAME} help' for the list of commands"
        return 1
    fi

    echo -e "${BOLD}${SCRIPT_NAME}${RESET} — dotfiles manager for dots-fedora"
    echo "Version: ${VERSION}"
    echo
    echo -e "${BOLD}USAGE:${RESET}"
    echo "    ${SCRIPT_NAME} [COMMAND] [ARGS]"
    echo "    ${SCRIPT_NAME}                 # default: stow --restow"
    echo
    echo -e "${BOLD}COMMANDS:${RESET}"
    echo "    stow                Create/refresh symlinks (default: --restow)"
    echo "    unstow              Remove all stow-managed symlinks"
    echo "    restow              Alias for 'stow' (explicit refresh)"
    echo "    doctor              Verify stow install and symlink health"
    echo "    link                Symlink this script into ~/.local/bin/dot"
    echo "    unlink              Remove the ~/.local/bin/dot symlink"
    echo "    edit                Open the repo in \$EDITOR"
    echo "    update [TARGET]     Update everything installed (dnf, flatpak, pi, vp, yazi, nvim)"
    echo "    outdated            Report outdated packages across every tool tracked (read-only)"
    echo "    help [COMMAND]      Show this help, or help for a specific command"
    echo
    echo -e "${BOLD}GLOBAL OPTIONS:${RESET}"
    echo "    --version           Show version and exit"
    echo "    -h, --help          Show this help and exit"
    echo
    echo -e "${BOLD}EXAMPLES:${RESET}"
    echo "    ${SCRIPT_NAME}                    # restow dotfiles (default)"
    echo "    ${SCRIPT_NAME} stow --no-restow   # additive stow only"
    echo "    ${SCRIPT_NAME} doctor             # check symlink health"
    echo "    ${SCRIPT_NAME} link               # install 'dot' to PATH"
    echo "    ${SCRIPT_NAME} update             # update everything already installed"
    echo "    ${SCRIPT_NAME} outdated           # check what's outdated without updating"
    echo
    echo -e "${BOLD}FILES:${RESET}"
    echo "    Repo:    ${DOTFILES_DIR}"
    echo "    Source:  ${HOME_DIR}"
    echo "    Target:  ${STOW_TARGET}"
    echo "    Pi pkgs: ${PI_PACKAGES_SCRIPT}"
    echo "    Ignore:  ${HOME_DIR}/.stow-local-ignore"
}

# ─── Main ───────────────────────────────────────────────────────────────────
main() {
    # Global flags first
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --version)
                echo "${SCRIPT_NAME} version ${VERSION}"
                exit 0
                ;;
            -h|--help)
                cmd_help
                exit 0
                ;;
            *)
                break
                ;;
        esac
        shift
    done

    local cmd="${1:-stow}"
    shift || true

    case "$cmd" in
        stow)    cmd_stow    "$@" ;;
        unstow)  cmd_unstow  "$@" ;;
        restow)  cmd_restow  "$@" ;;
        doctor)  cmd_doctor  "$@" ;;
        link)    cmd_link    "$@" ;;
        unlink)  cmd_unlink  "$@" ;;
        edit)    cmd_edit    "$@" ;;
        update)  cmd_update  "$@" ;;
        outdated) cmd_outdated "$@" ;;
        help)    cmd_help    "$@" ;;
        *)
            __print_error "Unknown command: $cmd"
            echo "Run '${SCRIPT_NAME} help' for usage"
            exit 1
            ;;
    esac
}

main "$@"
